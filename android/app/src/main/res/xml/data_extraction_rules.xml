<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup / device-transfer rules for Android 12+ (android:dataExtractionRules).
     Same reason as backup_rules.xml: the Keystore key doesn't travel, so neither
     should the secure-storage files that depend on it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    </device-transfer>
</data-extraction-rules>
