<?xml version="1.0" encoding="utf-8"?>
<!-- Languages DocsBuddy is translated into. Android 13+ lists exactly these under
     Settings → System → Languages → App languages → DocsBuddy. Keep in step with
     `AppLanguage` (lib/core/l10n/app_language.dart); test/platform/locale_config_test.dart
     fails when they drift. -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="zh-Hans" />
    <locale android:name="hi" />
    <locale android:name="es" />
    <locale android:name="fr" />
    <locale android:name="ar" />
</locale-config>
