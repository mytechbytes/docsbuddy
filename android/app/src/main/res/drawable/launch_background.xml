<?xml version="1.0" encoding="utf-8"?>
<!-- Launch window for Android 11 and below (Android 12+ uses the system splash
     configured in values-v31): the launcher-icon tint with the brand mark
     centred. Keep in step with StartupScreen, which continues from here. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <item
        android:width="224dp"
        android:height="224dp"
        android:gravity="center">
        <bitmap
            android:gravity="fill"
            android:src="@drawable/splash_mark" />
    </item>
</layer-list>
